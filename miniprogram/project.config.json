{
  "description": "Skiller 微信小程序",
  "appid": "touristappid",
  "projectname": "skiller",
  "compileType": "miniprogram",
  "libVersion": "3.4.0",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": ".test-build"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      },
      {
        "type": "file",
        "value": "tsconfig.json"
      },
      {
        "type": "file",
        "value": "tsconfig.test.json"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  },
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true,
    "ignoreUploadUnusedFiles": true,
    "useCompilerPlugins": [
      "typescript"
    ]
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
