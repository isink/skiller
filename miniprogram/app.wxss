/*
 * Design tokens
 * Spacing follows an 8pt grid (1pt = 2rpx, so one step = 16rpx; half steps are 8rpx).
 * One accent colour only; semantic success is reserved for radar status.
 */
page {
  /* color: surfaces, lowest to highest */
  --color-bg: #0c0e12;
  --color-surface: #14171d;
  --color-surface-2: #1b1f27;
  --color-surface-pressed: #202531;
  --color-border: #242a35;
  --color-border-strong: #313947;

  /* color: text hierarchy */
  --color-text: #f2f4f8;
  --color-text-2: #aab3c1;
  --color-text-3: #7f899a;

  /* color: accent (single) + semantic */
  --color-accent: #7c9bff;
  --color-accent-soft: rgba(124, 155, 255, 0.14);
  --color-accent-line: rgba(124, 155, 255, 0.4);
  --color-on-accent: #0c0e12;
  --color-success: #4fc38a;
  --color-success-soft: rgba(79, 195, 138, 0.14);
  --color-overlay: rgba(5, 7, 10, 0.72);

  /* spacing: 8pt grid in rpx */
  --space-half: 8rpx;
  --space-1: 16rpx;
  --space-2: 24rpx;
  --space-3: 32rpx;
  --space-4: 48rpx;
  --space-5: 64rpx;

  /* radius */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;

  /* type scale */
  --text-xs: 22rpx;
  --text-sm: 24rpx;
  --text-base: 28rpx;
  --text-md: 30rpx;
  --text-lg: 34rpx;
  --text-xl: 44rpx;
  --text-2xl: 56rpx;
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* layout */
  --tap-min: 88rpx;
  --tabbar-height: 104rpx;
  --page-gutter: 32rpx;
  --font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Segoe UI", sans-serif;
  font-size: var(--text-base);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, image { box-sizing: border-box; }
button::after { border: 0; }

/* page shell: gutters respect left/right safe areas, bottom respects the home indicator */
.page {
  min-height: 100vh;
  padding: var(--space-2) calc(var(--page-gutter) + env(safe-area-inset-right)) calc(var(--space-4) + env(safe-area-inset-bottom)) calc(var(--page-gutter) + env(safe-area-inset-left));
}
.page-with-tabbar {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + var(--space-3));
}

/* page header */
.hero { padding: var(--space-1) 0 var(--space-3); }
.hero-title { display: block; font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: 1.25; letter-spacing: 0.5rpx; }
.hero-subtitle { display: block; margin-top: var(--space-half); color: var(--color-text-2); font-size: var(--text-base); line-height: 1.5; }

/* text helpers */
.muted { color: var(--color-text-2); }
.subtle { color: var(--color-text-3); }
.brand { color: var(--color-accent); }

.row { display: flex; flex-direction: row; align-items: center; }
.space-between { justify-content: space-between; }

.section-title { display: block; margin: var(--space-4) 0 var(--space-2); color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; }

/* list card: title / summary / meta hierarchy */
.card {
  position: relative;
  margin-bottom: var(--space-2);
  padding: var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}
.card-hover { background: var(--color-surface-2); border-color: var(--color-border-strong); }

.skill-name { display: block; color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: 1.35; word-break: break-all; }
.skill-desc {
  display: -webkit-box;
  margin-top: var(--space-1);
  overflow: hidden;
  color: var(--color-text-2);
  font-size: var(--text-base);
  line-height: 1.55;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.meta { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: var(--space-2); gap: var(--space-1); }
.meta-tag {
  padding: 4rpx var(--space-1);
  border-radius: var(--radius-sm);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  line-height: 1.5;
}
.meta-author { color: var(--color-text-2); font-size: var(--text-sm); }
.source-meta {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-3);
  font-size: var(--text-xs);
  line-height: 1.6;
  column-gap: var(--space-2);
}

/* chips */
.chip-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--space-1); }
.chip {
  display: inline-block;
  flex-shrink: 0;
  height: 68rpx;
  margin-right: var(--space-1);
  padding: 0 var(--space-3);
  line-height: 66rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  color: var(--color-text-2);
  font-size: var(--text-sm);
  white-space: nowrap;
}
.chip-active { border-color: var(--color-accent-line); background: var(--color-accent-soft); color: var(--color-accent); font-weight: var(--weight-semibold); }

/* feedback */
.empty { padding: var(--space-5) var(--space-3); color: var(--color-text-3); text-align: center; line-height: 1.7; }
.empty-icon { display: block; width: 96rpx; height: 96rpx; margin: 0 auto var(--space-2); opacity: 0.9; }
.empty-title { display: block; color: var(--color-text-2); font-size: var(--text-md); font-weight: var(--weight-medium); }
.empty-desc { display: block; margin-top: var(--space-half); font-size: var(--text-sm); }
.notice { margin: var(--space-2) 0; color: var(--color-text-3); font-size: var(--text-sm); text-align: center; }

/* controls */
.primary-button { margin-top: var(--space-3); height: var(--tap-min); border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-on-accent); font-size: var(--text-base); font-weight: var(--weight-semibold); line-height: var(--tap-min); }
.search { height: var(--tap-min); padding: 0 var(--space-3); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); font-size: var(--text-base); }
.search-placeholder { color: var(--color-text-3); }
