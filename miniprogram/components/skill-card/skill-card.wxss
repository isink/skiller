.skill-card {
  padding: 32rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 32rpx;
}
.skill-card--hover { opacity: 0.75; }

.top { display: flex; align-items: flex-start; }
.top-main { flex: 1; min-width: 0; }

.title-row { display: flex; align-items: center; }
.name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}
.badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--brand);
  background: rgba(217, 119, 87, 0.2);
  border-radius: 999rpx;
}

.meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-subtle);
}
.star { color: var(--star); font-size: 20rpx; margin-right: 6rpx; }

.heart {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: -12rpx -12rpx 0 16rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--text-subtle);
}
.heart--on { color: var(--brand); }

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.chips { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--brand);
  background: rgba(217, 119, 87, 0.1);
  border: 1px solid rgba(217, 119, 87, 0.3);
  border-radius: 999rpx;
}
