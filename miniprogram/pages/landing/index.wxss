.landing-page { padding-top: var(--space-3); }

.brand-header { display: flex; flex-direction: row; align-items: center; }
.brand-mark { width: 80rpx; height: 80rpx; flex-shrink: 0; border-radius: var(--radius-md); }
.brand-text { display: flex; flex-direction: column; margin-left: var(--space-2); }
.brand-name { color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.2; letter-spacing: 1rpx; }
.brand-tagline { margin-top: 4rpx; color: var(--color-text-3); font-size: var(--text-xs); letter-spacing: 4rpx; }

.landing-intro { padding: var(--space-5) 0 var(--space-4); }
.landing-title { display: block; font-size: var(--text-2xl); font-weight: var(--weight-bold); line-height: 1.2; letter-spacing: 1rpx; }
.landing-subtitle { display: block; margin-top: var(--space-1); color: var(--color-text-2); font-size: var(--text-md); line-height: 1.5; }

.tool-section-label { display: block; margin-bottom: var(--space-2); color: var(--color-text-3); font-size: var(--text-xs); font-weight: var(--weight-medium); letter-spacing: 4rpx; }

.tool-grid { display: flex; flex-direction: row; gap: var(--space-2); }

.tool-tile {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  min-height: 340rpx;
  padding: var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}
.tool-tile-hover { border-color: var(--color-accent-line); background: var(--color-surface-pressed); }

.tool-tile-top { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: auto; padding-bottom: var(--space-3); }
.tool-icon-box { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: var(--radius-md); background: var(--color-accent-soft); }
.tool-icon { width: 48rpx; height: 48rpx; }
.tool-arrow { width: 32rpx; height: 32rpx; margin-top: var(--space-half); }

.tool-title { display: block; color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; }
.tool-desc { display: block; margin-top: var(--space-half); color: var(--color-text-2); font-size: var(--text-sm); line-height: 1.55; }
