.landing-page { padding-top: var(--space-3); }

.hot-card { display: flex; flex-direction: column; margin-bottom: var(--space-4); padding: var(--space-3); border: 1rpx solid var(--color-accent-line); border-radius: var(--radius-lg); background: var(--color-surface); }
.hot-card-hover { background: var(--color-surface-pressed); }
.hot-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.hot-head-main { display: flex; flex-direction: row; align-items: center; min-width: 0; gap: var(--space-1); }
.hot-badge { flex-shrink: 0; padding: 4rpx var(--space-1); border-radius: var(--radius-pill); background: var(--color-accent-soft); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 2rpx; }
.hot-growth { color: var(--color-text-3); font-size: var(--text-xs); }
.hot-name { display: block; margin-top: var(--space-2); color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.3; word-break: break-all; }
.hot-desc { display: -webkit-box; margin-top: var(--space-half); overflow: hidden; color: var(--color-text-2); font-size: var(--text-sm); line-height: 1.55; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.hot-copy { width: 100%; margin-top: var(--space-2); }
.hot-copy:active { opacity: 0.88; }

.hot-card-skeleton { min-height: 340rpx; border-color: var(--color-border); }
.hot-skeleton-line { height: 32rpx; margin-top: var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface-2); }
.hot-skeleton-badge { width: 200rpx; margin-top: 0; }
.hot-skeleton-name { width: 60%; }
.hot-skeleton-button { height: var(--tap-min); margin-top: var(--space-2); border-radius: var(--radius-pill); background: var(--color-surface-2); }

.landing-intro { padding: 0 0 var(--space-3); }
.landing-title { display: block; font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: 1.25; letter-spacing: 1rpx; }
.landing-subtitle { display: block; margin-top: var(--space-half); color: var(--color-text-2); font-size: var(--text-sm); line-height: 1.6; }

.scene-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; row-gap: var(--space-2); }
.scene-tile { display: flex; flex-direction: column; box-sizing: border-box; width: calc(50% - var(--space-1)); min-height: 196rpx; padding: var(--space-2) var(--space-3); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
.scene-tile-hover { border-color: var(--color-accent-line); background: var(--color-surface-pressed); }
.scene-tile-title { display: block; color: var(--color-text); font-size: var(--text-md); font-weight: var(--weight-bold); line-height: 1.3; }
.scene-tile-desc { display: -webkit-box; margin-top: var(--space-half); overflow: hidden; color: var(--color-text-2); font-size: var(--text-xs); line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.scene-tile-count { display: block; margin-top: auto; padding-top: var(--space-1); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); }

.more-links { display: flex; flex-direction: row; align-items: center; justify-content: center; margin-top: var(--space-5); color: var(--color-text-3); font-size: var(--text-sm); }
.more-label { margin-right: var(--space-1); }
.more-link { padding: var(--space-1) var(--space-half); color: var(--color-text-2); text-decoration: underline; }
.more-dot { margin: 0 var(--space-half); }

.tool-arrow { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.share-canvas { position: fixed; top: 0; left: -1600rpx; width: 750rpx; height: 600rpx; pointer-events: none; }
