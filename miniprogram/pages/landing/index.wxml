<view class="page landing-page">
  <view wx:if="{{hotLoading}}" class="hot-card hot-card-skeleton">
    <view class="hot-skeleton-line hot-skeleton-badge"></view>
    <view class="hot-skeleton-line hot-skeleton-name"></view>
    <view class="hot-skeleton-line"></view>
    <view class="hot-skeleton-button"></view>
  </view>
  <view wx:elif="{{hotTool}}" class="hot-card" hover-class="hot-card-hover" hover-stay-time="60" bindtap="openHotTool">
    <view class="hot-head">
      <view class="hot-head-main">
        <text class="hot-badge">{{hotLabel}}</text>
        <text wx:if="{{hotTool.growth}}" class="hot-growth">{{hotTool.growth}}</text>
      </view>
      <image class="tool-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <text class="hot-name">{{hotTool.name}}</text>
    <text wx:if="{{hotTool.purpose}}" class="hot-desc">{{hotTool.purpose}}</text>
    <button wx:if="{{hotCopyLabel}}" class="primary-button hot-copy" catchtap="onCopyHotInstall" aria-label="{{hotCopyLabel}}">{{hotCopyLabel}}</button>
  </view>

  <view class="brand-header">
    <image class="brand-mark" src="/assets/icons/brand.png" mode="aspectFit" />
    <view class="brand-text">
      <text class="brand-name">头山</text>
      <text class="brand-tagline">AI 工具箱</text>
    </view>
  </view>

  <view class="landing-intro">
    <text class="landing-title">探索 AI 技能与趋势</text>
    <text class="landing-subtitle">发现优质技能，追踪热门新词</text>
  </view>

  <text class="tool-section-label">全部工具</text>

  <view class="tool-grid">
    <navigator class="tool-tile" url="/pages/home/index" open-type="reLaunch" hover-class="tool-tile-hover" hover-stay-time="60" bindtap="markLandingEntered">
      <view class="tool-tile-top">
        <view class="tool-icon-box">
          <image class="tool-icon" src="/assets/icons/layers.png" mode="aspectFit" />
        </view>
        <image class="tool-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
      </view>
      <text class="tool-title">AI 技能库</text>
      <text class="tool-desc">浏览、搜索和收藏优质技能</text>
    </navigator>

    <navigator class="tool-tile" url="/pages/radar/index" open-type="reLaunch" hover-class="tool-tile-hover" hover-stay-time="60" bindtap="markLandingEntered">
      <view class="tool-tile-top">
        <view class="tool-icon-box">
          <image class="tool-icon" src="/assets/icons/radar.png" mode="aspectFit" />
        </view>
        <image class="tool-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
      </view>
      <text class="tool-title">新词雷达</text>
      <text class="tool-desc">追踪 AI 领域热门新词与趋势</text>
    </navigator>
  </view>

  <canvas type="2d" id="share-canvas" class="share-canvas"></canvas>
</view>
