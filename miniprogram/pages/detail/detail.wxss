.header { margin-bottom: 32rpx; }
.title-row { display: flex; align-items: flex-start; }
.title-main { flex: 1; min-width: 0; }
.name { font-size: 44rpx; font-weight: 700; color: var(--text-primary); word-break: break-all; }
.badge {
  display: inline-block;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  vertical-align: 8rpx;
  color: var(--brand);
  background: rgba(217, 119, 87, 0.2);
  border-radius: 999rpx;
}
.heart {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: -8rpx -12rpx 0 16rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--text-muted);
}
.heart--on { color: var(--brand); }

.meta { margin-top: 16rpx; font-size: 24rpx; color: var(--text-subtle); }
.star { color: var(--star); font-size: 22rpx; margin-right: 6rpx; }
.desc { display: block; margin-top: 24rpx; font-size: 30rpx; line-height: 1.55; color: var(--text-muted); }

.source { padding: 32rpx; margin-bottom: 40rpx; }
.block-title { font-size: 26rpx; font-weight: 600; color: var(--text-subtle); }
.hint { margin-top: 16rpx; font-size: 26rpx; line-height: 1.5; color: var(--text-muted); }
.hint--small { font-size: 22rpx; color: var(--text-subtle); }

.source-box {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-default);
  border-radius: 24rpx;
}
.url {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--brand);
  word-break: break-all;
}

.copy {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 26rpx;
  color: var(--brand);
}
.copy--done { color: var(--accent-green); }

.md-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.md-loading { padding: 32rpx 0; text-align: center; color: var(--brand); font-size: 40rpx; }

.spinner-wrap { display: flex; justify-content: center; padding-top: 240rpx; }
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(217, 119, 87, 0.25);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
