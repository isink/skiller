<view class="page detail-page">
  <view wx:if="{{loading}}" class="notice">正在加载技能详情…</view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <block wx:if="{{skill}}">
    <view class="detail-header">
      <view class="row detail-title-row">
        <text class="detail-title">{{skill.name}}</text>
        <view class="favorite-button {{favorited ? 'favorite-on' : ''}}" catchtap="onToggleFavorite">
          <image class="favorite-icon" src="{{favorited ? '/assets/icons/heart-filled.png' : '/assets/icons/heart.png'}}" mode="aspectFit" />
        </view>
      </view>
      <text wx:if="{{usageHeadline}}" class="detail-headline">{{usageHeadline}}</text>
      <text class="detail-description">{{displayDescription}}</text>
      <view wx:if="{{!usageHeadline}}" class="chip-row detail-tags">
        <text class="tag tag-primary">{{displayCategory}}</text>
        <text wx:for="{{skill.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
      <view class="detail-meta"><text class="detail-meta-label">作者</text><text class="detail-meta-value">{{skill.author}}</text></view>
      <view class="detail-source-meta"><text>{{displayStars}}</text><text>{{displayUpdated}}</text></view>
      <view wx:if="{{usageExample}}" class="example-card">
        <text class="install-title">效果示例</text>
        <text class="example-label">发给 WorkBuddy</text>
        <text class="example-input" selectable>{{usageExample.input}}</text>
        <text class="example-label">它给出的结果</text>
        <text class="example-output" selectable>{{usageExample.output}}</text>
      </view>
      <view class="install-card">
        <view class="install-heading">
          <text class="install-title">安装 Skill</text>
          <button wx:if="{{installCommand}}" class="install-copy" bindtap="onCopyInstall" aria-label="{{installCopyLabel}}">{{installCopyLabel}}</button>
        </view>
        <text wx:if="{{installCommand}}" class="install-command" selectable>{{installCommand}}</text>
        <text class="install-hint">{{installHint}}</text>
        <view wx:if="{{installAlternatives.length}}" class="install-alts">
          <view wx:for="{{installAlternatives}}" wx:key="label" class="install-alt" data-index="{{index}}" bindtap="onCopyAlternative">
            <text class="install-alt-label">{{item.label}} · 点按复制</text>
            <text class="install-alt-command">{{item.command}}</text>
          </view>
        </view>
        <view wx:if="{{installSteps.length}}" class="install-steps">
          <text class="install-steps-title">3 步装好</text>
          <view wx:for="{{installSteps}}" wx:key="index" class="install-step">
            <text class="install-step-no">{{index + 1}}</text>
            <text class="install-step-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{usageSay.length}}" class="usage-card">
        <text class="install-title">装好后这样说</text>
        <view wx:for="{{usageSay}}" wx:key="index" class="usage-item" data-index="{{index}}" bindtap="onCopyUsage">
          <text class="usage-text">“{{item}}”</text>
          <text class="usage-action">复制</text>
        </view>
        <view class="usage-scene" data-slug="{{usageScene.slug}}" bindtap="openScene">
          <text>收录于「{{usageScene.title}}」合集 · 看同岗位的其他技能</text>
          <image class="usage-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
        </view>
      </view>
      <view class="source-card">
        <view wx:if="{{sourceUrl}}" class="source-row">
          <text class="source-label">原链接</text>
          <text class="source-value" selectable>{{sourceUrl}}</text>
          <button class="source-action" bindtap="onCopySource" aria-label="复制原链接">复制</button>
        </view>
        <view wx:if="{{displayLicense}}" class="source-row">
          <text class="source-label">许可证</text>
          <text class="source-value">{{displayLicense}}</text>
        </view>
        <view class="source-row">
          <text class="source-label">作者</text>
          <text class="source-value">是作者？申请下架或反馈</text>
          <button class="source-action" bindtap="onFeedback" aria-label="作者申请下架或反馈">联系</button>
        </view>
      </view>
      <button class="share-button" open-type="share" aria-label="推荐给同事">推荐给同事</button>
    </view>
    <view class="markdown-card">
      <view class="markdown-toggle" bindtap="onToggleMarkdown">
        <text class="markdown-title">{{usageHeadline ? '技术说明（英文原文）' : '技能说明全文'}}</text>
        <text class="markdown-toggle-action">{{markdownOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{markdownOpen}}" wx:for="{{blocks}}" wx:key="index">
        <view wx:if="{{item.type === 'heading'}}" class="md-heading md-h{{item.level}}"><rich-text nodes="{{item.inline}}" /></view>
        <view wx:elif="{{item.type === 'paragraph'}}" class="md-paragraph"><rich-text nodes="{{item.inline}}" /></view>
        <view wx:elif="{{item.type === 'list'}}" class="md-list"><rich-text nodes="{{item.inline}}" /></view>
        <view wx:elif="{{item.type === 'quote'}}" class="md-quote"><rich-text nodes="{{item.inline}}" /></view>
        <scroll-view wx:elif="{{item.type === 'code'}}" scroll-x class="md-code"><text selectable>{{item.text}}</text></scroll-view>
        <view wx:elif="{{item.type === 'rule'}}" class="md-rule"></view>
      </block>
    </view>
    <canvas type="2d" id="share-canvas" class="share-canvas"></canvas>
  </block>
</view>
