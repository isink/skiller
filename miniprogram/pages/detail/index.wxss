.detail-page { padding-top: var(--space-1); }

.detail-header { margin-bottom: var(--space-2); padding: var(--space-3); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
.detail-title-row { align-items: flex-start; }
.detail-title { flex: 1; min-width: 0; font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: 1.25; word-break: break-all; }

.favorite-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: var(--tap-min); height: var(--tap-min); margin: -16rpx -16rpx 0 var(--space-half); border-radius: 50%; }
.favorite-button:active { background: var(--color-surface-2); }
.favorite-icon { width: 44rpx; height: 44rpx; }

.detail-description { display: block; margin-top: var(--space-1); color: var(--color-text-2); font-size: var(--text-md); line-height: 1.65; }
.detail-tags { margin-top: var(--space-2); gap: var(--space-1); }
.tag { margin: 0; padding: 4rpx var(--space-2); border-radius: var(--radius-pill); background: var(--color-surface-2); color: var(--color-text-2); font-size: var(--text-xs); line-height: 1.6; }
.tag-primary { background: var(--color-accent-soft); color: var(--color-accent); font-weight: var(--weight-medium); }

.detail-meta { display: flex; flex-direction: row; align-items: baseline; margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1rpx solid var(--color-border); font-size: var(--text-sm); }
.detail-meta-label { margin-right: var(--space-1); color: var(--color-text-3); }
.detail-meta-value { color: var(--color-text); font-weight: var(--weight-medium); }
.detail-source-meta { display: flex; flex-direction: column; margin-top: var(--space-half); color: var(--color-text-3); font-size: var(--text-xs); line-height: 1.7; }

.install-card { margin-top: var(--space-2); padding: var(--space-2); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
.install-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
.install-title { color: var(--color-text); font-size: var(--text-sm); font-weight: var(--weight-semibold); }
.install-copy { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: var(--tap-min); margin: -12rpx -8rpx -12rpx 0; padding: 0 var(--space-1); border-radius: var(--radius-sm); background: transparent; color: var(--color-accent); font-size: var(--text-sm); font-weight: var(--weight-medium); line-height: 1.4; }
.install-copy::after { border: 0; }
.install-copy:active { background: var(--color-accent-soft); }
.install-command { display: block; margin-top: var(--space-1); color: var(--color-text); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.install-hint { display: block; margin-top: var(--space-1); color: var(--color-text-3); font-size: var(--text-xs); line-height: 1.6; }
.install-alts { margin-top: var(--space-2); }
.install-alt { margin-top: var(--space-1); padding: var(--space-1) var(--space-2); border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); }
.install-alt:active { background: var(--color-surface-pressed); }
.install-alt-label { display: block; color: var(--color-text-3); font-size: var(--text-xs); }
.install-alt-command { display: block; margin-top: 4rpx; color: var(--color-text); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; word-break: break-all; }
.install-steps { margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1rpx solid var(--color-border); }
.install-steps-title { display: block; margin-bottom: var(--space-1); color: var(--color-text); font-size: var(--text-sm); font-weight: var(--weight-semibold); }
.install-step { display: flex; flex-direction: row; align-items: flex-start; margin-top: var(--space-1); }
.install-step-no { flex-shrink: 0; width: 40rpx; height: 40rpx; margin-right: var(--space-1); border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); line-height: 40rpx; text-align: center; }
.install-step-text { flex: 1; min-width: 0; color: var(--color-text-2); font-size: var(--text-sm); line-height: 1.6; }

.source-card { margin-top: var(--space-2); padding: 0 var(--space-2); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
.source-row { display: flex; flex-direction: row; align-items: center; min-height: var(--tap-min); border-top: 1rpx solid var(--color-border); font-size: var(--text-sm); }
.source-row:first-child { border-top: 0; }
.source-label { flex-shrink: 0; width: 112rpx; color: var(--color-text-3); }
.source-value { flex: 1; min-width: 0; padding: var(--space-1) 0; color: var(--color-text-2); line-height: 1.5; word-break: break-all; }
.source-action { flex-shrink: 0; min-height: var(--tap-min); margin: 0 -8rpx 0 var(--space-1); padding: 0 var(--space-1); background: transparent; color: var(--color-accent); font-size: var(--text-sm); font-weight: var(--weight-medium); line-height: var(--tap-min); }
.source-action::after { border: 0; }
.source-action:active { background: var(--color-accent-soft); }

.share-button { margin-top: var(--space-2); height: var(--tap-min); border: 1rpx solid var(--color-accent-line); border-radius: var(--radius-pill); background: var(--color-accent-soft); color: var(--color-accent); font-size: var(--text-base); font-weight: var(--weight-semibold); line-height: calc(var(--tap-min) - 2rpx); }
.share-button:active { background: var(--color-surface-pressed); }
.share-canvas { position: fixed; top: 0; left: -1600rpx; width: 750rpx; height: 600rpx; pointer-events: none; }

.markdown-card { padding: var(--space-3); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
.markdown-title { display: block; color: var(--color-text-3); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 4rpx; }
.md-heading { margin: var(--space-3) 0 var(--space-1); color: var(--color-text); font-weight: var(--weight-bold); line-height: 1.35; }
.md-h1 { font-size: var(--text-xl); }
.md-h2 { font-size: var(--text-lg); }
.md-h3 { font-size: var(--text-md); }
.md-h4, .md-h5, .md-h6 { font-size: var(--text-base); }
.md-paragraph, .md-list, .md-quote { display: block; margin: var(--space-1) 0; color: var(--color-text-2); font-size: var(--text-base); line-height: 1.75; white-space: pre-wrap; }
.md-quote { padding: var(--space-1) var(--space-2); border-left: 4rpx solid var(--color-accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--color-surface-2); color: var(--color-text-2); }
.md-code { margin: var(--space-2) 0; padding: var(--space-2); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.65; white-space: pre; }
.md-rule { height: 1rpx; margin: var(--space-3) 0; background: var(--color-border); }
rich-text code { padding: 2rpx 8rpx; border-radius: 8rpx; background: var(--color-surface-2); color: var(--color-accent); font-family: var(--font-mono); }
rich-text strong { color: var(--color-text); font-weight: var(--weight-bold); }

.usage-card { margin-top: var(--space-3); padding: var(--space-3); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
.usage-item { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-1); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface-2); }
.usage-item:active { background: var(--color-surface-pressed); }
.usage-text { flex: 1; min-width: 0; color: var(--color-text); font-size: var(--text-sm); line-height: 1.6; }
.usage-action { flex-shrink: 0; margin-left: var(--space-2); color: var(--color-accent); font-size: var(--text-sm); font-weight: var(--weight-medium); }
.usage-scene { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: var(--space-2); color: var(--color-accent); font-size: var(--text-sm); }
.usage-arrow { width: 28rpx; height: 28rpx; flex-shrink: 0; }

.detail-headline { display: block; margin-top: var(--space-1); color: var(--color-accent); font-size: var(--text-md); font-weight: var(--weight-semibold); line-height: 1.45; }
.example-card { margin-top: var(--space-3); padding: var(--space-3); border: 1rpx solid var(--color-accent-line); border-radius: var(--radius-md); background: var(--color-surface); }
.example-label { display: block; margin-top: var(--space-2); color: var(--color-text-3); font-size: var(--text-xs); }
.example-input { display: block; margin-top: 4rpx; color: var(--color-text); font-size: var(--text-sm); line-height: 1.6; }
.example-output { display: block; margin-top: 4rpx; padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface-2); color: var(--color-text); font-size: var(--text-sm); line-height: 1.7; white-space: pre-wrap; }
.markdown-toggle { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: var(--tap-min); margin: calc(-1 * var(--space-2)) 0; }
.markdown-toggle-action { color: var(--color-accent); font-size: var(--text-sm); font-weight: var(--weight-medium); }
.markdown-toggle + .md-heading, .markdown-toggle + .md-paragraph, .markdown-toggle + .md-list, .markdown-toggle + .md-quote, .markdown-toggle + .md-code, .markdown-toggle + .md-rule { margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1rpx solid var(--color-border); }
