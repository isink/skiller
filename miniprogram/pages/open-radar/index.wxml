<view class="page">
  <view class="hero">
    <text class="hero-title">开源雷达</text>
    <text class="hero-subtitle">值得关注的开源 AI 项目，附中文摘要与上手要点</text>
  </view>

  <view wx:if="{{loading}}" class="notice">加载中…</view>
  <view wx:elif="{{error}}" class="empty">
    <text class="empty-title">{{error}}</text>
    <button class="primary-button retry-button" bindtap="reload">重新加载</button>
  </view>
  <view wx:elif="{{items.length === 0}}" class="empty">
    <text class="empty-title">开源雷达筹备中</text>
    <text class="empty-desc">第一批精选项目整理好后会出现在这里</text>
  </view>
  <view wx:else class="radar-list">
    <view wx:for="{{items}}" wx:key="id" class="radar-row" hover-class="radar-row-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openItem" aria-role="button" aria-label="{{item.titleZh}}">
      <view class="radar-row-main">
        <text class="radar-row-title">{{item.titleZh}}</text>
        <text wx:if="{{item.summary}}" class="radar-row-summary">{{item.summary}}</text>
      </view>
      <image class="radar-row-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
    </view>
  </view>
</view>
