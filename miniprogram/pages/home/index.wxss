.eyebrow { display: block; margin-bottom: var(--space-half); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 4rpx; }

.search-wrap { position: relative; }
.search-icon { position: absolute; top: 28rpx; left: var(--space-2); z-index: 1; width: 32rpx; height: 32rpx; }
.search { padding-left: 80rpx; padding-right: 128rpx; }
.clear-search { position: absolute; top: 0; right: 0; width: 120rpx; height: var(--tap-min); color: var(--color-accent); font-size: var(--text-sm); line-height: var(--tap-min); text-align: center; }

.section-heading { margin-top: 0; }
.section-heading .section-title { margin-bottom: var(--space-2); }
.more { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; height: var(--tap-min); margin-top: var(--space-4); margin-bottom: var(--space-2); padding-left: var(--space-2); color: var(--color-text-2); font-size: var(--text-sm); }
.more-arrow { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

.count { margin-left: var(--space-half); color: var(--color-text-3); font-size: var(--text-sm); font-weight: var(--weight-regular); }

.category-scroll { margin: 0 calc(-1 * var(--page-gutter)); white-space: nowrap; }
.category-row { display: flex; flex-direction: row; padding: 0 var(--page-gutter); }
.category-card { flex-shrink: 0; width: 216rpx; margin-right: var(--space-1); padding: var(--space-2); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
.category-card:active { border-color: var(--color-accent-line); background: var(--color-surface-pressed); }
.category-name { display: block; color: var(--color-text); font-size: var(--text-base); font-weight: var(--weight-semibold); }
.category-count { display: block; margin-top: 4rpx; color: var(--color-text-3); font-size: var(--text-xs); }

.flex-title { flex: 1; min-width: 0; }
.featured-mark { flex-shrink: 0; margin-left: var(--space-1); padding: 4rpx var(--space-1); border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-on-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); line-height: 1.5; }
