.hero { padding: 22rpx 0 28rpx; }
.eyebrow { display: block; color: #d97757; font-size: 19rpx; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 14rpx; font-size: 46rpx; font-weight: 750; }
.hero-subtitle { display: block; margin-top: 12rpx; color: #9696a2; font-size: 24rpx; }
.search-wrap { position: relative; }
.search { padding-right: 110rpx; }
.clear-search { position: absolute; top: 22rpx; right: 24rpx; color: #d78a70; font-size: 23rpx; }
.section-heading { margin-top: 4rpx; }
.section-heading .section-title { margin-top: 34rpx; }
.more { padding-top: 28rpx; color: #a7a7b1; font-size: 24rpx; }
.category-scroll { width: calc(100vw - 32rpx); margin-right: -32rpx; }
.category-row { display: flex; padding: 2rpx 24rpx 8rpx 0; }
.category-card { flex-shrink: 0; width: 190rpx; margin-right: 14rpx; padding: 22rpx; border: 1rpx solid #292932; border-radius: 20rpx; background: #15151b; }
.category-name { display: block; font-size: 26rpx; font-weight: 650; }
.category-count { display: block; margin-top: 8rpx; color: #888894; font-size: 21rpx; }
.count { font-size: 24rpx; font-weight: 400; }
.skill-card { position: relative; }
.flex-title { flex: 1; }
.featured-mark { margin-left: 12rpx; padding: 6rpx 12rpx; border-radius: 8rpx; background: #3a2420; color: #eba184; font-size: 19rpx; }
