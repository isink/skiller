<view class="page page-with-tabbar">
  <view class="hero">
    <text class="eyebrow">AISkill技能库</text>
    <text class="hero-title">发现值得用的 Skills</text>
    <text class="hero-subtitle">浏览、搜索和收藏优质技能</text>
  </view>

  <view class="search-wrap">
    <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
    <input class="search" value="{{query}}" placeholder="搜索名称、简介或作者" placeholder-class="search-placeholder" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
    <text wx:if="{{query}}" class="clear-search" catchtap="clearSearch">清除</text>
  </view>

  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{searching}}" class="notice">正在搜索…</view>

  <block wx:if="{{query}}">
    <view class="section-title">搜索结果 <text class="count">{{results.length}}</text></view>
    <view wx:if="{{!searching && results.length === 0}}" class="empty"><text class="empty-title">没有匹配的技能</text><text class="empty-desc">试试其他关键词</text></view>
    <view wx:for="{{results}}" wx:key="id" class="card skill-card" hover-class="card-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openSkill">
      <text class="skill-name">{{item.name}}</text>
      <text class="skill-desc">{{item.displayDescription}}</text>
      <view class="meta"><text class="meta-tag">{{item.displayCategory}}</text><text class="meta-author">{{item.author}}</text></view>
      <view class="source-meta"><text>{{item.displayStars}}</text><text>{{item.displayUpdated}}</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="row space-between section-heading">
      <text class="section-title">分类浏览</text>
      <view class="more" bindtap="openAllCategories"><text>全部</text><image class="more-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" /></view>
    </view>
    <scroll-view wx:if="{{categories.length}}" scroll-x class="category-scroll" show-scrollbar="false">
      <view class="category-row">
        <view wx:for="{{categories}}" wx:key="id" class="category-card" data-slug="{{item.slug}}" bindtap="openCategory">
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{counts[item.slug] || 0}} 个技能</text>
        </view>
      </view>
    </scroll-view>
    <view wx:elif="loading" class="notice">正在读取分类…</view>

    <view class="section-title">精选技能</view>
    <view wx:if="{{loading && featured.length === 0}}" class="notice">正在加载…</view>
    <view wx:for="{{featured}}" wx:key="id" class="card skill-card" hover-class="card-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openSkill">
      <view class="row space-between"><text class="skill-name flex-title">{{item.name}}</text><text wx:if="{{item.featured}}" class="featured-mark">精选</text></view>
      <text class="skill-desc">{{item.displayDescription}}</text>
      <view class="meta"><text class="meta-tag">{{item.displayCategory}}</text><text class="meta-author">{{item.author}}</text></view>
      <view class="source-meta"><text>{{item.displayStars}}</text><text>{{item.displayUpdated}}</text></view>
    </view>
    <view wx:if="{{featured.length === 0 && !loading}}" class="empty">暂时没有技能数据</view>

    <view class="section-title">最近收录</view>
    <view wx:for="{{latest}}" wx:key="id" class="card skill-card" hover-class="card-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openSkill">
      <text class="skill-name">{{item.name}}</text>
      <text class="skill-desc">{{item.displayDescription}}</text>
      <view class="meta"><text class="meta-tag">{{item.displayCategory}}</text><text class="meta-author">{{item.author}}</text></view>
      <view class="source-meta"><text>{{item.displayStars}}</text><text>{{item.displayUpdated}}</text></view>
    </view>
  </block>

  <skill-tabbar active="home"></skill-tabbar>
</view>
