<view class="container">
  <scroll-view scroll-x class="chip-row" enhanced show-scrollbar="{{false}}">
    <view class="chip-wrap">
      <category-chip label="{{t.all}}" count="{{totalCount}}" active="{{!category}}" value="" bind:select="onSelectCategory" />
    </view>
    <view wx:for="{{categories}}" wx:key="slug" class="chip-wrap">
      <category-chip
        label="{{item.label}}"
        count="{{item.count}}"
        active="{{category === item.slug}}"
        value="{{item.slug}}"
        bind:select="onSelectCategory"
      />
    </view>
  </scroll-view>

  <view class="modes">
    <view class="mode {{mode === 'repos' ? 'mode--active' : ''}}" data-mode="repos" bindtap="onSelectMode">{{t.repos}}</view>
    <view class="mode {{mode === 'skills' ? 'mode--active' : ''}}" data-mode="skills" bindtap="onSelectMode">{{t.skills}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this" class="list-item"><skill-skeleton /></view>
  </block>

  <block wx:elif="{{mode === 'skills'}}">
    <empty-state wx:if="{{!skills.length}}" icon="☐" title="{{t.noSkills}}" />
    <view wx:for="{{skills}}" wx:key="id" class="list-item">
      <skill-card skill="{{item}}" />
    </view>
    <pagination
      wx:if="{{skills.length && totalPages > 1}}"
      page="{{page}}"
      total="{{totalPages}}"
      bind:change="onPageChange"
    />
  </block>

  <block wx:else>
    <empty-state wx:if="{{!repos.length}}" icon="☐" title="{{t.noRepos}}" />
    <view wx:for="{{repos}}" wx:key="repo" class="list-item">
      <repo-group-card group="{{item}}" />
    </view>
  </block>
</view>
