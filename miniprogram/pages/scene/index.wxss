.scene-head { margin-bottom: var(--space-3); padding: var(--space-3); border: 1rpx solid var(--color-accent-line); border-radius: var(--radius-lg); background: var(--color-surface); }
.scene-badge { display: inline-block; padding: 4rpx var(--space-1); border-radius: var(--radius-pill); background: var(--color-accent-soft); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 2rpx; }
.scene-title { display: block; margin-top: var(--space-2); color: var(--color-text); font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: 1.25; }
.scene-tagline { display: block; margin-top: var(--space-half); color: var(--color-text-2); font-size: var(--text-base); line-height: 1.5; }
/* `.scene-head` raises specificity above WeChat's default `button:not([size=mini]) { width: 184px }`. */
.scene-head .scene-bundle { width: 100%; }
.scene-bundle:active { opacity: 0.88; }
.scene-sort { display: block; margin-top: var(--space-half); color: var(--color-text-3); font-size: var(--text-xs); }
.scene-hint { display: block; margin-top: var(--space-1); color: var(--color-text-3); font-size: var(--text-xs); line-height: 1.6; }

.scene-skill { display: block; }
.scene-skill-head { display: flex; flex-direction: row; align-items: flex-start; }
.scene-rank { flex-shrink: 0; width: 44rpx; height: 44rpx; margin-right: var(--space-1); border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-on-accent); font-size: var(--text-xs); font-weight: var(--weight-bold); line-height: 44rpx; text-align: center; }
.scene-stars { flex-shrink: 0; margin-left: var(--space-1); padding: 4rpx var(--space-1); border-radius: var(--radius-pill); background: var(--color-surface-2); color: var(--color-text-3); font-size: var(--text-xs); line-height: 1.5; }
.scene-headline { flex: 1; min-width: 0; color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.35; }
.scene-skill-name { display: block; margin: var(--space-half) 0 0 calc(44rpx + var(--space-1)); color: var(--color-text-2); font-size: var(--text-sm); font-weight: var(--weight-medium); word-break: break-all; }
.scene-skill-en { color: var(--color-text-3); font-size: var(--text-xs); font-weight: normal; }
.scene-prepare { display: block; margin-bottom: var(--space-1); padding-bottom: var(--space-1); border-bottom: 1rpx solid var(--color-border); color: var(--color-text-2); font-size: var(--text-xs); line-height: 1.6; }
.scene-say { margin-top: var(--space-2); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--color-surface-2); }
.scene-say-label { display: block; color: var(--color-text-3); font-size: var(--text-xs); }
.scene-say-text { display: block; margin-top: 4rpx; color: var(--color-text); font-size: var(--text-sm); line-height: 1.6; }
.scene-actions { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: var(--space-2); }
.scene-copy { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 var(--space-3); min-height: 72rpx; border: 1rpx solid var(--color-accent-line); border-radius: var(--radius-pill); background: transparent; color: var(--color-accent); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: 1.4; }
.scene-copy::after { border: 0; }
.scene-copy:active { background: var(--color-accent-soft); }
.scene-detail-link { color: var(--color-text-3); font-size: var(--text-sm); }

.scene-section-label { display: block; margin: var(--space-4) 0 var(--space-2); color: var(--color-text-3); font-size: var(--text-xs); font-weight: var(--weight-medium); letter-spacing: 4rpx; }
.scene-others { display: flex; flex-direction: row; flex-wrap: wrap; row-gap: var(--space-1); }

.share-canvas { position: fixed; top: 0; left: -1600rpx; width: 750rpx; height: 600rpx; pointer-events: none; }
