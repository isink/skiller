<view class="page scene-page">
  <view wx:if="{{!scene}}" class="empty">没有找到这个合集。</view>
  <block wx:else>
    <view class="scene-head">
      <text class="scene-badge">WorkBuddy 技能合集</text>
      <text class="scene-title">{{scene.title}}</text>
      <text class="scene-tagline">{{scene.tagline}}</text>
      <button wx:if="{{bundleReady}}" class="primary-button scene-bundle" bindtap="onCopyBundle">一键复制给 WorkBuddy，全部装上</button>
      <text class="scene-hint">复制后粘贴进电脑上的 WorkBuddy 对话框发送，它会逐个装好。</text>
    </view>

    <view wx:if="{{error}}" class="notice">{{error}}</view>
    <view wx:if="{{loading && skills.length === 0}}" class="notice">正在加载技能…</view>
    <view wx:for="{{skills}}" wx:key="id" class="card scene-skill" hover-class="card-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openSkill">
      <text class="skill-name">{{item.name}}</text>
      <text wx:if="{{item.purpose}}" class="scene-purpose">{{item.purpose}}</text>
      <view wx:if="{{item.say}}" class="scene-say">
        <text class="scene-say-label">装好后这样说</text>
        <text class="scene-say-text">“{{item.say}}”</text>
      </view>
      <button wx:if="{{item.copyLabel}}" class="scene-copy" data-index="{{index}}" catchtap="onCopySkill">{{item.copyLabel}}</button>
    </view>

    <text class="scene-others-label">其他岗位</text>
    <view class="scene-others">
      <text wx:for="{{others}}" wx:key="slug" class="chip" data-slug="{{item.slug}}" bindtap="openScene">{{item.title}}</text>
    </view>
  </block>
  <canvas type="2d" id="share-canvas" class="share-canvas"></canvas>
</view>
