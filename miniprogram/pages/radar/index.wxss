.term-header { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }
.term-name { flex: 1; min-width: 0; margin-right: var(--space-2); color: var(--color-text); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: 1.35; word-break: break-all; }
.term-summary {
  display: -webkit-box;
  margin-top: var(--space-1);
  overflow: hidden;
  color: var(--color-text-2);
  font-size: var(--text-base);
  line-height: 1.6;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* status chip: neutral by default, success for hit, accent for converted topic */
.status-chip { display: flex; flex-shrink: 0; flex-direction: row; align-items: center; padding: 4rpx var(--space-1); border-radius: var(--radius-pill); background: var(--color-surface-2); color: var(--color-text-2); }
.status-chip::before { content: ""; width: 10rpx; height: 10rpx; margin-right: 8rpx; border-radius: 50%; background: currentColor; }
.status-text { color: inherit; font-size: var(--text-xs); font-weight: var(--weight-medium); line-height: 1.5; }
.status-hit { background: var(--color-success-soft); color: var(--color-success); }
.status-topic { background: var(--color-accent-soft); color: var(--color-accent); }

/* score bar: score is 0..1 and drives the fill width */
.score-row { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-2); }
.score-label { flex-shrink: 0; width: 64rpx; color: var(--color-text-3); font-size: var(--text-xs); }
.score-track { flex: 1; height: 8rpx; overflow: hidden; border-radius: var(--radius-pill); background: var(--color-surface-2); }
.score-track-lg { height: 12rpx; }
.score-fill { height: 100%; border-radius: var(--radius-pill); background: var(--color-accent); }
.score-value { flex-shrink: 0; width: 96rpx; color: var(--color-text); font-size: var(--text-sm); font-weight: var(--weight-semibold); text-align: right; }

.term-meta { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-1); gap: var(--space-2); }
.meta-item { color: var(--color-text-3); font-size: var(--text-xs); }

.loading-more, .no-more { padding: var(--space-3) 0; color: var(--color-text-3); font-size: var(--text-sm); text-align: center; }

/* detail sheet */
.modal-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; display: flex; align-items: flex-end; justify-content: center; background: var(--color-overlay); }
.modal-content {
  width: 100%;
  max-height: 80vh;
  padding: var(--space-1) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
  overflow-y: auto;
  border: 1rpx solid var(--color-border);
  border-bottom: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-surface);
}
.modal-handle { width: 72rpx; height: 8rpx; margin: 0 auto var(--space-3); border-radius: var(--radius-pill); background: var(--color-border-strong); }
.modal-header { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-2); }
.modal-title { flex: 1; min-width: 0; margin-right: var(--space-2); font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: 1.25; word-break: break-all; }
.modal-summary { display: block; margin-bottom: var(--space-3); color: var(--color-text-2); font-size: var(--text-md); line-height: 1.7; }

.modal-score { margin-bottom: var(--space-2); padding: var(--space-2); border-radius: var(--radius-md); background: var(--color-surface-2); }
.modal-score-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-1); }
.modal-score-value { color: var(--color-accent); font-size: var(--text-lg); font-weight: var(--weight-bold); }
.modal-score .score-track { background: var(--color-border); }

.modal-meta-grid { display: flex; flex-direction: row; gap: var(--space-2); margin-bottom: var(--space-3); }
.meta-grid-item { flex: 1; min-width: 0; padding: var(--space-2); border-radius: var(--radius-md); background: var(--color-surface-2); }
.meta-label { display: block; color: var(--color-text-3); font-size: var(--text-xs); }
.meta-value { display: block; margin-top: 4rpx; color: var(--color-text); font-size: var(--text-md); font-weight: var(--weight-semibold); }

.modal-close { height: var(--tap-min); border: 1rpx solid var(--color-border-strong); border-radius: var(--radius-pill); color: var(--color-text); font-size: var(--text-base); font-weight: var(--weight-medium); line-height: calc(var(--tap-min) - 2rpx); text-align: center; }
.modal-close:active { background: var(--color-surface-pressed); }
