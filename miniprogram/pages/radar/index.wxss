.hero { padding: 22rpx 0 28rpx; }
.hero-title { display: block; font-size: 46rpx; font-weight: 750; }
.hero-subtitle { display: block; margin-top: 12rpx; color: #9696a2; font-size: 24rpx; }

.term-card { margin-bottom: 20rpx; }
.term-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.term-name { flex: 1; font-size: 32rpx; font-weight: 650; }
.status-badge { padding: 6rpx 16rpx; border-radius: 12rpx; }
.status-text { color: #fff; font-size: 20rpx; font-weight: 500; }
.term-summary { display: block; margin-bottom: 16rpx; color: #a8a8b2; font-size: 25rpx; line-height: 1.6; }
.term-meta { display: flex; gap: 20rpx; }
.meta-item { color: #787884; font-size: 22rpx; }

.loading-more, .no-more { padding: 30rpx 0; text-align: center; color: #6b6b75; font-size: 24rpx; }

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 620rpx;
  max-height: 80vh;
  background: #1a1a22;
  border-radius: 28rpx;
  padding: 40rpx;
  overflow-y: auto;
}

.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.modal-title { flex: 1; font-size: 36rpx; font-weight: 700; }
.modal-summary { display: block; margin-bottom: 32rpx; color: #b8b8c2; font-size: 28rpx; line-height: 1.7; }

.modal-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-bottom: 36rpx; }
.meta-grid-item { padding: 24rpx; background: #15151b; border-radius: 16rpx; }
.meta-label { display: block; margin-bottom: 8rpx; color: #888894; font-size: 22rpx; }
.meta-value { display: block; color: #d97757; font-size: 30rpx; font-weight: 600; }

.modal-close {
  width: 100%;
  padding: 24rpx;
  text-align: center;
  background: #2a2a34;
  border-radius: 16rpx;
  color: #d8d8e2;
  font-size: 28rpx;
  font-weight: 500;
}
