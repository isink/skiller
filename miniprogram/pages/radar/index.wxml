<view class="page">
  <view class="hero">
    <view class="hero-heading">
      <text class="hero-title">新词雷达</text>
      <view class="favorites-link" bindtap="openFavorites" aria-role="button" aria-label="查看已收藏的新词">新词收藏<text wx:if="{{favoriteCount}}"> · {{favoriteCount}}</text></view>
    </view>
    <text class="hero-subtitle">看看哪些 AI 项目与模型正受关注</text>
  </view>

  <view class="board-tabs">
    <view class="board-tab {{mode === 'github' ? 'board-tab-active' : ''}}" data-mode="github" bindtap="changeMode" aria-role="button" aria-label="项目榜，按 GitHub Star 排序">项目榜</view>
    <view class="board-tab {{mode === 'huggingface' ? 'board-tab-active' : ''}}" data-mode="huggingface" bindtap="changeMode" aria-role="button" aria-label="模型榜，按 Hugging Face 近30日下载排序">模型榜</view>
    <view class="board-tab {{mode === 'latest' ? 'board-tab-active' : ''}}" data-mode="latest" bindtap="changeMode" aria-role="button" aria-label="最新发现">最新发现</view>
  </view>

  <view wx:if="{{!boardAvailable}}" class="notice">热度数据准备中，先看看最新发现</view>
  <view wx:if="{{mode !== 'latest'}}" class="board-caption">
    <text class="board-metric">{{mode === 'github' ? 'GitHub Star · 项目 TOP 50' : 'Hugging Face 近30日下载 · 模型 TOP 50'}}</text>
    <text class="board-sync">{{displayCheckedAt ? '最近核对 ' + displayCheckedAt + ' · 定期更新' : '数据定期核对'}}</text>
  </view>
  <view wx:else class="calendar-panel">
    <view class="calendar-toolbar">
      <text class="calendar-selection">{{selectedDateLabel}}</text>
      <view class="calendar-tools">
        <view class="calendar-all {{!selectedDate ? 'calendar-all-active' : ''}}" bindtap="clearDateFilter" aria-role="button" aria-label="查看所有日期的新词">全部</view>
        <view class="calendar-toggle" bindtap="toggleCalendar" aria-role="button" aria-expanded="{{calendarExpanded}}">{{calendarExpanded ? '收起日历' : '展开日历'}} <text aria-hidden="true">{{calendarExpanded ? '⌃' : '⌄'}}</text></view>
      </view>
    </view>
    <view wx:if="{{!calendarExpanded}}" class="recent-days">
      <view wx:for="{{recentDays}}" wx:key="key" class="recent-day {{item.isSelected ? 'calendar-day-selected' : ''}}" data-date="{{item.date}}" bindtap="selectDate" aria-role="button" aria-label="{{item.date}}，{{item.isToday ? '今天，' : ''}}{{item.isSelected ? '已选中' : '查看当天新词'}}">
        <text class="recent-weekday">{{item.isToday ? '今天' : item.weekdayLabel}}</text>
        <text class="recent-number">{{item.dayLabel}}</text>
      </view>
    </view>
    <block wx:else>
      <view class="calendar-month-toolbar">
        <view class="month-nav {{calendarMonth === '1900-01' ? 'month-nav-disabled' : ''}}" data-delta="-1" bindtap="moveCalendarMonth" aria-role="button" aria-label="上个月">‹</view>
        <picker mode="date" fields="month" value="{{calendarMonth + '-01'}}" start="1900-01-01" end="{{today}}" bindchange="changeCalendarMonth" class="month-picker">
          <view class="calendar-month-label">{{calendarMonthLabel}} <text aria-hidden="true">⌄</text></view>
        </picker>
        <view class="month-nav {{canNextMonth ? '' : 'month-nav-disabled'}}" data-delta="1" bindtap="moveCalendarMonth" aria-role="button" aria-disabled="{{!canNextMonth}}" aria-label="下个月">›</view>
      </view>
      <view class="calendar-weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
      <view class="month-days">
        <view wx:for="{{monthDays}}" wx:key="key" class="month-day {{item.isSelected ? 'calendar-day-selected' : ''}} {{item.isToday && !item.isSelected ? 'calendar-day-today' : ''}} {{item.isDisabled ? 'calendar-day-disabled' : ''}}" data-date="{{item.date}}" bindtap="selectDate" aria-role="button" aria-hidden="{{item.isPadding}}" aria-disabled="{{item.isDisabled}}" aria-label="{{item.date}}，{{item.isToday ? '今天，' : ''}}{{item.isSelected ? '已选中' : '查看当天新词'}}">{{item.dayLabel}}</view>
      </view>
    </block>
    <text class="calendar-hint">点日期查看当天发现，点“全部”浏览所有日期</text>
  </view>

  <view wx:if="{{hasPendingUpdate}}" class="update-notice" bindtap="showUpdatedBoard" aria-role="button">{{mode === 'latest' ? '有新内容，点击刷新' : '榜单有更新，点击刷新'}} <text aria-hidden="true">↻</text></view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{loading && terms.length === 0}}" class="notice">正在加载…</view>

  <block wx:for="{{terms}}" wx:key="term">
    <view wx:if="{{mode === 'latest' && !selectedDate && (index === 0 || item.displayDate !== terms[index - 1].displayDate)}}" class="date-heading">{{item.displayDateGroup}}</view>
    <view class="term-row">
      <text wx:if="{{mode !== 'latest'}}" class="term-rank {{index < 3 ? 'term-rank-top' : ''}}">{{index + 1}}</text>
      <view class="term-content">
        <text class="term-name">{{item.term}}</text>
        <text class="term-summary {{item.hasSummary ? '' : 'term-summary-pending'}}">{{item.displaySummary}}</text>
        <view wx:if="{{mode !== 'latest' && item.hasPopularity}}" class="term-popularity">
          <text class="popularity-value">{{item.displayPopularity}} {{mode === 'github' ? 'Star' : '次下载'}}</text>
          <text wx:if="{{item.popularityNeedsRetry}}" class="popularity-retry">待重新核对 · {{item.displayPopularityCheckedAt}}</text>
        </view>
      </view>
      <view class="term-favorite {{item.isFavorite ? 'term-favorite-active' : ''}}" data-index="{{index}}" catchtap="toggleFavorite" aria-role="button" aria-label="{{item.isFavorite ? '取消收藏' : '收藏'}}{{item.term}}">
        <image class="favorite-icon" src="{{item.isFavorite ? '/assets/icons/heart-filled.png' : '/assets/icons/heart.png'}}" mode="aspectFit" />
      </view>
    </view>
  </block>

  <view wx:if="{{terms.length === 0 && !loading && !error}}" class="empty">
    <text class="empty-title">{{mode === 'latest' ? (selectedDate ? '这一天暂无新发现' : '暂无新词数据') : '暂无24小时内已核对的数据'}}</text>
    <text class="empty-desc">{{mode === 'latest' ? (selectedDate ? '试试其他日期，或点“全部”查看' : '有新的收录后会出现在这里') : '可先查看最新发现'}}</text>
  </view>
  <view wx:if="{{loading && terms.length > 0}}" class="loading-more">加载中…</view>
  <view wx:if="{{!hasMore && terms.length > 0}}" class="no-more">{{mode === 'latest' ? (selectedDate ? '当天内容已显示完' : '没有更多了') : '仅展示24小时内核对的来源'}}</view>
  <view wx:if="{{recommended.length > 0}}" class="recommend">
    <text class="section-title">{{recommendTitle}}</text>
    <view wx:for="{{recommended}}" wx:key="id" class="card skill-card" hover-class="card-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="openSkill">
      <text class="skill-name">{{item.name}}</text>
      <view wx:if="{{item.displayGrowth || item.displayAdded}}" class="fresh-row">
        <text wx:if="{{item.displayGrowth}}" class="fresh-hot">{{item.displayGrowth}}</text>
        <text wx:if="{{item.displayAdded}}" class="fresh-new">{{item.displayAdded}}</text>
        <text wx:if="{{item.displayRepoNote}}" class="fresh-note">{{item.displayRepoNote}}</text>
      </view>
      <text class="skill-desc">{{item.displayDescription}}</text>
      <view class="meta"><text class="meta-tag">{{item.displayCategory}}</text><text class="meta-author">{{item.author}}</text></view>
      <view class="source-meta"><text>{{item.displayStars}}</text><text>{{item.displayUpdated}}</text></view>
    </view>
  </view>
  <view class="explore-entry" bindtap="openExplore" aria-role="button" aria-label="去探索更多 AI 技能"><text>去探索更多技能</text><image class="explore-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" /></view>
</view>
