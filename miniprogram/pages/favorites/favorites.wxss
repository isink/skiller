.error {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  background: var(--bg-card);
  border-radius: 24rpx;
}
.error-retry { font-weight: 600; color: var(--brand); }
.note { margin-top: 40rpx; text-align: center; font-size: 22rpx; color: var(--text-subtle); }
