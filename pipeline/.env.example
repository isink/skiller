SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
DEEPSEEK_API_KEY=<optional-for-enrichment>
GITHUB_TOKEN=<required-for-daily-metadata-refresh>

# Open radar candidate fetch (npm run import:open-radar). Only the token is needed;
# the optional OPEN_RADAR_* variables are listed in pipeline/README.md.
PRODUCT_HUNT_TOKEN=<optional-product-hunt-developer-token>

# Only needed for the mini-program catalog migration/sync.
CLOUDBASE_ENV_ID=<cloudbase-environment-id>
CLOUDBASE_API_KEY=<server-only-key-with-database-access>
